# Dependencies
node_modules/

# NOTE: this package used to vendor three pinned @deepseek-ai provider packages under vendor/ and
# depend on them through `file:./vendor/<dir>`. That is gone, for two independent reasons:
#
#  1. Committing them here would re-distribute DeepSeek's own published npm packages.
#  2. A `prepare` script that fetched them from npm could not work anyway: pnpm resolves a git
#     dependency's own `file:` dependencies BEFORE running `prepare`, so the vendored directories do
#     not exist yet when they are needed (`ERR_PNPM_LINKED_PKG_DIR_NOT_FOUND`). Measured, not assumed.
#
# The three providers are published on npm as @deepseek-ai/dsh-browser-use,
# @deepseek-ai/dsh-experimental-browser-use-runtime and
# @deepseek-ai/dsh-experimental-browser-use-chrome-devtools-mcp, and package.json now depends on the
# published versions directly.
vendor/

# Package artifacts
*.tgz

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
